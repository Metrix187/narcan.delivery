// Copy this file to secrets.h and fill in. secrets.h is gitignored.
#pragma once

// --- WiFi (2.4 GHz; the C6 is single-band) -------------------------------
#define WIFI_SSID      "your-network"
#define WIFI_PASSWORD  "your-password"

// --- Source of truth -----------------------------------------------------
// The dataset the live site publishes. Git is the source of truth; this is
// its public mirror, and the guardian keeps an off-cloud copy of it.
#define DATA_JSON_URL  "https://narcan.delivery/data.json"

// --- Optional failover trigger -------------------------------------------
// Cloudflare Pages "Deploy hook" URL. When the guardian declares the site
// DEAD, it POSTs this once to rebuild from git, which can clear a bad
// deploy. Leave empty to disable.
#define DEPLOY_HOOK_URL ""
